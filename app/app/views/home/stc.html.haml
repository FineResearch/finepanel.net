.row
  .four.columns
    = image_tag('campaigns/stc_images/children1.jpg')
  .four.columns
    = image_tag('campaigns/stc_images/children2.jpg')
  .four.columns
    = image_tag('campaigns/stc_images/children3.jpg')

#modal-stc-mx-letter.reveal.medium{'data-reveal' => ""}
  %p
    = image_tag("campaigns/save_the_children_2014.png")
  %button.close-button{"aria-label" => "Close modal", "data-close" => "", :type => "button"}
    %span{"aria-hidden" => "true"} ×

#modal-stc-campaign.reveal.medium{'data-reveal' => ""}
  %p
    = image_tag("campaigns/stc_images/stc_letter.#{I18n.locale}.jpg")
  %button.close-button{"aria-label" => "Close modal", "data-close" => "", :type => "button"}
    %span{"aria-hidden" => "true"} ×
