.row.commitments
  .medium-12.small-12.columns
    %h3
      = t('commitments.page_title')
    %hr

    %h5
      = t 'commitments.page_subtitle'

    %ol.medium-12.columns.medium-offset-1
      %li
        %strong
          = t 'commitments.standards'
        = t 'commitments.standards_p'

      %li
        %strong
          = t 'commitments.privacy'
        = t 'commitments.privacy_p'

      %li
        %strong
          = t 'commitments.fees'
        = t 'commitments.fees_p'

      %ul.medium-offset-1
        %li
          = t 'commitments.fees_li1'
        %li
          = t 'commitments.fees_li2'
        %li
          = t 'commitments.fees_li3'
        %li
          = t 'commitments.fees_li4'
        %li
          = t 'commitments.fees_li5'
        %li
          = t 'commitments.fees_li6'
        %li
          = t 'commitments.fees_li7'
        %li
          = t 'commitments.fees_li8'
        %li
          = t 'commitments.fees_li9'

      %li
        %strong
          = t 'commitments.social_responsibility'
        = t 'commitments.social_responsibility_p'

      %li
        %strong
          = t 'commitments.transparency'
        = t 'commitments.transparency_p'

        %ul.medium-offset-1
          %li
            = t 'commitments.transparency_li1'
          %li
            = t 'commitments.transparency_li2'

      %li
        %strong
          = t 'commitments.willfulness'
        = t 'commitments.willfulness_p'


      %li
        %strong
          = t 'commitments.mission'
        = t 'commitments.mission_p'

      %li
        %strong
          = t 'commitments.scope'
        = t 'commitments.scope_p'

      %li
        %strong
          = t 'commitments.responsibility'
        = t 'commitments.responsibility_p'

      %li
        %strong
          = t 'commitments.autonomy'
        = t 'commitments.autonomy_p'
