- if history.any?
  %table#history_payment_table.responsive
    %tbody
      %tr
        %th= t('dashboard.payment_history.project')
        %th= t('dashboard.payment_history.fee')
        %th= t('dashboard.payment_history.comment')
        %th= t('dashboard.payment_history.date')
        %th
      - if payment_row
        %tr.payment-item{:class => ("payment-row")}
          %th= t('dashboard.payment_history.today_credit.comment_project')
          %th
          %th
          %th= t('dashboard.payment_history.today_credit.day')
          %th
      - if credit_row
        %tr.payment-item
          %th= t('dashboard.payment_history.today_credit.comment_project')
          %th
          %th
          %th= t('dashboard.payment_history.today_credit.day')
          %th
      - history.each do |payment|
        %tr.payment-item{:class => ("payment-row" if payment.credit < 0)}
          %th= payment.project_name
          %th= "#{cookies[:currency]} #{payment.credit}"
          %th= history_payment_concept(payment.concept)
          %th= payment.email_date.to_time.strftime('%d/%m/%Y')
          %th
- else
  .alert-box.message
    = t('dashboard.payment_history.no_info')
