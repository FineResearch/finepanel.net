#dynamed-access
  %div.text-center
    - if dynamed_enable?(user_data)
      %strong
        = t('dynamed_access')
      = image_tag('doctors_dynamed.jpg', class: "dynamed-img") 
      = link_to image_tag('logos/dynamed-button.png'), ConfigurationReader.dynamed_subdomain, class: "dynamed-logo"
    - else
      %strong
        = t('dynamed_read_more')
      = image_tag('doctors_dynamed.jpg', class: "dynamed-img") 
      = link_to image_tag('logos/dynamed-button.png'), dynamed_disabled_path, class: "dynamed-logo"
