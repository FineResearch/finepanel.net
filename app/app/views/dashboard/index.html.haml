.row#main-content
  .small-12.medium-12.columns
    .row.main
      #main.small-12.medium-8.columns
        .medium-12.columns
          #participate_btn_text.hide
            = t('dashboard.participate')
          #project_text.hide
            = t('dashboard.project')
        #available-surveys.medium-12.columns
          %h4= t('dashboard.survey_list.available_surveys')
          #available-surveys-container{ data: { 'loading-message': t('dashboard.loading')} }
            = render 'surveys/available_surveys', survey_list: @survey_list
        #survey-history.columns.medium-12
          .row#survey-history-container{ data: { 'loading-message': t('dashboard.loading')} }
            = render 'surveys/last_surveys', participations: @participations
      #sidebar.small-12.medium-4.columns.updates
        .row
          #payment-panel.columns.small-12.medium-12
            #payment-panel-container{ data: { 'loading-message': t('dashboard.loading')} }
              = render 'payment_panel', payment_info: @payment_info
            #invite
              = link_to t('dashboard.invite_collegues'), users_refer_colleague_path, class: 'button invite'
    .row.comments-sidebar-row
      .small-12.medium-8.columns
        = render 'finepanel_wall', posts: @posts, show_pagination: true
      .small-12.medium-4.columns
        = render 'dynamed_content_sidebar', user_data: @user_data
        #campaigns-sidebar
          = render 'campaign_sidebar'
