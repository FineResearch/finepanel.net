.row.margin-home#footer
  .columns
    %ul.left.link-list
      %li
        = link_to t("footer.faq"), faq_path
      %li
        = link_to t("footer.contact"), contact_path
    .right
      = image_tag('logos/save_the_children.png', class: "save_the_children")
      = image_tag('logos/aacd2.png', class: "aacd")
      = image_tag('logos/icw.png', class: "icw")
.row.download-row
  %a{:href => "https://play.google.com/store/apps/details?id=com.lumi.fineresearch"}
    = image_tag('download/android-download.png', class: "download-icon")
  %a{:href => "https://apps.apple.com/us/app/fine-panel/id1049244979"}
    = image_tag('download/ios-download.png', class: "download-icon")
