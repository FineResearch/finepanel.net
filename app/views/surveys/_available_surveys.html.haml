%table
  %tbody
    %tr
    - if survey_list.any?
      - survey_list.each do |survey|
        %tr
          %td.survey-info
            .subject
              = survey[:subject]
            .code
              = "#{survey[:name]}: "
              %span.time
                = survey[:duration]
          %td.survey-status
            - if survey_progress_status(survey[:status]).present?
              = link_to survey_progress_status(survey[:status]), survey[:link], target: :_blank
          %td.survey-list-btn
            = link_to "Participe! #{t('dashboard.participate')} #{survey[:fee]}", survey[:link], target: :_blank, class: "button small answer survey-item-btn"
    - else
      %tr#survey-info-status
        %td{colspan: 5}
          = t('dashboard.survey_list.there_is_no_information_about_surveys_to_show')
