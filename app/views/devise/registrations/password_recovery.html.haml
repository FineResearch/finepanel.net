.row.margin-home
  .medium-12.small-12.columns
    %h3
      = t('registrations.password_recovery.title')
    %p
      =t('registrations.password_recovery.description')
.row.margin-home
  .medium-8.columns.medium-centered
    = form_tag users_send_password_path, :class => 'custom registration-form' do
      .row
        .medium-3.small-12.columns.text-right
          = label_tag :email, t('activerecord.attributes.user.email'), :class => 'inline required'
        .medium-9.small-12.columns
          = text_field_tag :email, nil, required: true
      .row
        .medium-9.columns.medium-offset-3
          %span.gray
            %small
              = t('forms.required_fields_notice')
      .row
        .medium-3.columns.text-right
          = submit_tag t('forms.submit'), :class => 'regular button'
