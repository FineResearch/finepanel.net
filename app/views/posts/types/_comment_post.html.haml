.medium-1.small-12.columns
  -if news_comment?(post.user)
    = news_image
  -elsif support_comment?(post.user_info)
    = support_image
  -else
    .glyph.big n
.medium-11.small-12.columns
  %p
    = post.user_info['complete_name']
    = t('posts.shared_a_comment')
    %small
      %em
        = t "posts.news.published_at", date: l(post.created_at)
  %blockquote
    = post.text
    %cite
      = post.user_info['complete_name']
      = " - #{t('specialties.s' + post.user_info['specialty'].to_s)}" if post.user_info['specialty'].present?
      = " - #{post.user_info['country']}"
      = " - #{post.user_info['city']}" if post.user_info['city'].present?
