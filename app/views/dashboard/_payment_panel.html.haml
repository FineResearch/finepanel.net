.panel.callout
  .row
    .small-12.medium-12.columns
      %span.pending_money
        %h2
          = "$#{@payment_info[:credit]}"
        %h5
          = t('dashboard.balance.pending')

.panel.payment-info.callout
  .row
    .small-12.medium-12.columns
      %ul
        %li
          %span
            = t('dashboard.balance.paid')
          %span.right
            = "$#{@payment_info[:total_payments]}"
        %li
          %span
            = t('dashboard.balance.total_fees')
          %span.right
            = "$#{@payment_info[:total]}"
