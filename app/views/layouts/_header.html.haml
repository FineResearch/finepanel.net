.row.margin-home
  .twelve.columns
    #header
      .row
        .columns.small-12.medium-3
          %h1#logo
            = link_to(content_tag(:span, "Finepanel"), root_path)
        .columns.small-12.medium-9
          .row#login
            %form.columns.small-12.medium-7
              .row
                .columns.small-12.medium-5.mobile-four
                  %input#email{ name: "email", placeholder: t('forms.email'), type: "text" }/
                .columns.small-12.medium-5.mobile-four
                  %input#password.right{ name: "password", placeholder: t('forms.password'), type: "password", :value => "" }/
                .columns.small-12.medium-2.mobile-four
                  %button.button.small{ name: "button", type: "submit" } Ingresar
              .row
                .columns.small-12.medium-6.mobile-two
                  %label.grey
                    = check_box_tag :remember_me
                    = t('forms.remember')
                .columns.small-12.medium-6.mobile-two
                  %label
                    = link_to(content_tag(:span, t('header.forgot_password')), root_path)

            .links.columns.small-12.medium-5.padding-home
              .row.collapse
                .columns.small-12.medium-3.mobile-two
                  .home-language
                    = render "language"
                .columns.small-12.medium-7.mobile-two#new-account
                  = link_to t('header.get_an_account'), root_path, class: "button secondary round small"
