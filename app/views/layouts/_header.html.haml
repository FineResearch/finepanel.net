.row.margin-home
  .medium-12.columns
    #header
      .row.header-row
        .div
          %h1#logo
            = link_to(content_tag(:span, "Finepanel"), root_path)
        - unless user_signed_in?
          .columns.small-12.medium-9
            .row#login
              = form_for(User.new, as: :user, url: session_path(:user), html: { class: 'columns small-7' } ) do |f|
                .row
                  .columns.small-12.medium-5.mobile-four
                    = f.email_field :email, autocomplete: "email", placeholder: t('forms.email'), id: 'email'
                  .columns.small-12.medium-5.mobile-four
                    = f.password_field :password, autocomplete: "current-password", placeholder: t('forms.password'), class: 'right'
                  .columns.small-12.medium-2.mobile-four
                    = f.submit t('header.login'), class: "button small btn-login"
                .row
                  .columns.small-12.medium-6.mobile-two
                    %label.grey
                      = check_box_tag :remember_me
                      = t('forms.remember')
                  .columns.small-12.medium-6.mobile-two
                    %label
                      = link_to(content_tag(:span, t('header.forgot_password')), root_path)

              .links.columns.small-12.medium-5.padding-home
                .row.collapse
                  .columns.small-12.medium-3.mobile-two
                    .home-language
                      = render "language"
                  .columns.small-12.medium-7.mobile-two#new-account
                    = link_to t('header.get_an_account'), new_user_registration_path, class: "button secondary round small"
        - else
          .header-nav-menu
            %nav
              .toggle
                %li.toggle-topbar.menu-icon.header-menu
                  %a{href: ""}
              %ul.nav-bar.left.ul-signed-in
                %li.has-flyout.li-signed-in.nav-item
                  .dropdown
                    = button_tag class: 'dropdown-toggle user-name', data: { toggle: 'menu' } do
                      = current_user.email
                    .dropdown-menu
                      %ul.flyout
                        %li
                          = link_to t('header.logout'), destroy_user_session_path, method: :delete
                    .dropdown-menu-mobile
                      %ul
                        %li.nav-item.nav-sub-item
                          = link_to t('header.logout'), destroy_user_session_path, method: :delete

                %li.nav-item
                  %a{:href => root_path}
                    = t ('header.support')
                %li.nav-item
                  %a{:href => root_path}
                    = t ('header.my_areas_of_interest')

                %li.nav-item
                  %a{:href => root_path}
                    = t "header.news"
                %li.language
                  .home-language
                    = render "language"
