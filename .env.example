# Copiar como .env y completar solo lo que haga falta para desarrollo local.
# NINGUN valor real de produccion debe pegarse aqui.

APP_HOST=localhost:3000
RAILS_ENV=development

# --- Base de datos (Postgres local, distinta de produccion) ---
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=finepanel_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DB_POOL=5

# --- Redis / Sidekiq (local, no produccion) ---
REDIS_URL=redis://redis:6379

# --- Switches de aislamiento (Etapa 4): en local deben quedar en true ---
DISABLE_WHATSAPP_SEND=true
DISABLE_EMAIL_DELIVERY=true

# --- SendGrid (dejar vacio en local; con DISABLE_EMAIL_DELIVERY=true no se usa) ---
SENDGRID_API_KEY=
SENDGRID_USERNAME=
SENDGRID_PASSWORD=
NOTIFICATIONS_API_USERNAME=
NOTIFICATIONS_API_PASSWORD=

# --- Meta WhatsApp (dejar vacio en local; con DISABLE_WHATSAPP_SEND=true no se usa) ---
# Si en algun momento se quiere probar contra un numero real de prueba de Meta,
# completar solo ese numero de test, nunca los de produccion.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_AUTH_TOKEN=
WHATSAPP_ID_NUMBER=
WHATSAPP_AR_NUMBER=
WHATSAPP_AR_NUMBER_ID=
WHATSAPP_BR_NUMBER=
WHATSAPP_BR_NUMBER_ID=
WHATSAPP_CO_NUMBER=
WHATSAPP_CO_NUMBER_ID=
WHATSAPP_MX_NUMBER=
WHATSAPP_MX_NUMBER_ID=

# --- Otras integraciones externas (no confirmadas como criticas para el inbox, dejar vacias) ---
APP_FRONTEND_URL=http://localhost:3001
API_DYNAMED_URL=https://apis.ebsco.com
TRANSLATE_KEY=
EMAIL_NEWS_RECIPIENT=
DYNAMED_CLIENT_ID=
DYNAMED_CLIENT_SECRET=
TWILIO_SENDER_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Confirmit/Forsta SOAP API (Fine Panel Set Up) ---
# Cuenta de servicio unica compartida (api_fineresearch), no es la cuenta personal de nadie.
CONFIRMIT_API_USERNAME=
CONFIRMIT_API_PASSWORD=
