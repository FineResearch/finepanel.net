FROM ruby:2.5.1-alpine

##########################
# Arguments              #
##########################

ARG AUTOMATICALLY_MIGRATE=true

ENV AUTOMATICALLY_MIGRATE=$AUTOMATICALLY_MIGRATE

##########################
# Install software       #
##########################

# Install base packages and other software
RUN apk add --no-cache jq nodejs build-base postgresql-dev libxml2-dev libxslt-dev sqlite-dev tzdata \
  git openssh postgresql

# PSPP (compila la sintaxis SPSS re-etiquetada a .sav real, ver
# RelabelSpssExportWorker) -- DESHABILITADO (2026-09-30, segundo intento).
# Se penso que el SEGFAULT anterior (ver commits previos) era por la
# emulacion QEMU de "docker build --platform linux/amd64" corriendo local
# en una maquina ARM -- se armo un pipeline de build en CodeBuild
# (buildspec.yml) para correr en hardware x86_64 real y evitar eso, PERO
# el mismo RUN revienta IGUAL ahi (mismo "Segmentation fault (core
# dumped)", exit 139, confirmado en logs reales de CodeBuild). Esto
# descarta la hipotesis de la emulacion: es "apk-tools" de Alpine 3.7
# (2018) crasheando al procesar el APKINDEX de "edge" tal cual esta HOY
# (2026) -- una incompatibilidad de formato/version de ~8 anios entre esa
# base vieja y el repo edge actual, no un problema de arquitectura ni de
# confianza de firma. Sin PSPP instalado, RelabelSpssExportWorker no
# rompe -- su propio fallback (ver #build_output_paths) manda el zip
# original sin re-etiquetar en vez de fallar. Pendiente: la unica salida
# viable que probamos y anduvo (copiar un binario ya instalado desde un
# Alpine mas nuevo) tambien crashea EN TIEMPO DE EJECUCION por deps de
# GTK/glib faltantes -- este RUN necesita repensarse desde otra base
# (Debian/Ubuntu para esta capa, o PSPP como servicio aparte), no un
# parche mas sobre Alpine 3.7.
#
# RUN echo 'https://dl-cdn.alpinelinux.org/alpine/edge/testing' >> /etc/apk/repositories && \
#   echo 'https://dl-cdn.alpinelinux.org/alpine/edge/community' >> /etc/apk/repositories && \
#   echo 'https://dl-cdn.alpinelinux.org/alpine/edge/main' >> /etc/apk/repositories && \
#   apk update --allow-untrusted && apk add --no-cache --allow-untrusted pspp

##########################
# Set working directory  #
##########################

# Set working directory this directoy is going to
# be used by default
WORKDIR /app

##########################
# Add manifest files     #
##########################

# Copy metadata files that are used to install
# dependencies
COPY Gemfile Gemfile.lock ./

##########################
# Configure dependencies #
##########################

# Set the place where bundle is going to install gems
ENV BUNDLE_PATH /bundle

# Configure bundle to to build nokogiri using system libraries
RUN bundle config --global build.nokogiri --use-system-libraries

##########################
# App Instalation        #
##########################

COPY . /app

ENV RAILS_ENV production

RUN bundle install --jobs `expr $(cat /proc/cpuinfo | grep -c "cpu cores") - 1` --retry 3 && \
  bundle exec rake assets:precompile

##########################
# Run the app            #
##########################

ENTRYPOINT ["/app/entrypoint.release.sh"]

# --- SSL.com root CA fix (required after cert renewal) ---
RUN apk add --no-cache ca-certificates openssl \
 && mkdir -p /usr/local/share/ca-certificates

COPY sslcom-root-ca-rsa.crt /usr/local/share/ca-certificates/sslcom-root-ca-rsa.crt

RUN update-ca-certificates

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# --- end SSL.com fix ---




CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]
